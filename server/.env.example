# Environment
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_USER=root
DB_PASSWORD=root
DB_NAME=mtm

# Database (PostgreSQL connection string)
# Format: postgresql://user:password@hostname:port/database
# Must be a literal string — dotenv/Prisma do NOT expand ${DB_*} variables here.
DATABASE_URL=postgresql://root:root@localhost:5432/mtm

# Server
PORT=5000

# Domain Names  
DOMAIN_NAME_DEV=localhost
DOMAIN_NAME_PROD=yourdomain.com

# JWT Configuration
JWT_SECRET=your_secret_key_change_this_in_production
JWT_ACCESS_TOKEN_EXPIRES=15m
JWT_REFRESH_TOKEN_EXPIRES=7d
TOKEN_COOKIE_NAME=mtm_token
