{
  "name": "my-task-manager",
  "version": "2.0.0",
  "main": "index.js",
  "repository": "git@github.com:predmaxim/My-Task-Manager.git",
  "author": "Maxim Predybailo <predmaxim@ya.ru>",
  "license": "MIT",
  "scripts": {
    "start": "concurrently \"yarn server\" \"yarn client\"",
    "server": "cd server && yarn start",
    "client": "cd client && yarn dev",
    "migrate": "cd server && yarn migrate",
    "inst": "cd server && yarn install && cd ../client && yarn install && cd .."
  },
  "devDependencies": {
    "concurrently": "^10.0.3"
  },
  "dependencies": {
    "@dnd-kit/modifiers": "^7.0.0"
  }
}
